# Database
DATABASE_URL="postgresql://user:password@host:port/database"
DIRECT_URL="postgresql://user:password@host:port/database"

# Authentication
JWT_SECRET=your-secure-jwt-secret-here
# JWT_EXPIRATION is currently hardcoded to 60m in auth.module.ts

# Security / Encryption
ENCRYPTION_SECRET=your-strong-encryption-secret-here
ENCRYPTION_SALT=your-encryption-salt-here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Bootstrap Security — required to call POST /auth/bootstrap
# Generate with: openssl rand -hex 32
BOOTSTRAP_SECRET=your-extremely-secret-bootstrap-token-here

# Seed Passwords (used only during `npm run seed`)
SEED_DEFAULT_PASSWORD=your-secure-seed-password-here
SEED_ADMIN_PASSWORD=your-secure-admin-seed-password-here
SUPER_ADMIN_EMAIL=superadmin@basaeer.com

# Email / SMTP Configuration
# Recommended provider: Brevo (https://brevo.com) - free tier: 300 emails/day
# Alternative providers: SendGrid, Mailgun, AWS SES, Gmail
#
# BREVO SETUP:
# 1. Create account at brevo.com
# 2. Verify your sender email in Senders > Add Sender
# 3. Go to SMTP & API > SMTP settings
# 4. Copy SMTP server credentials:
#    - Server: smtp-relay.brevo.com
#    - Port: 587 (or 465 for SSL)
#    - Login: your SMTP login (usually an email or alphanumeric)
#    - Password: your SMTP key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-login@brevo.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@basaeer.edu

# For testing/development only (falls back to ethereal.email)
# Leave commented or remove in production
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=demo@basaeer.edu
# SMTP_PASS=password
# SMTP_FROM=admissions@basaeer.edu

# Google Meet Integration
GOOGLE_MEET_CLIENT_ID=your-google-client-id
GOOGLE_MEET_CLIENT_SECRET=your-google-client-secret
GOOGLE_MEET_REDIRECT_URI=https://your-backend-url/api/meet/oauth2callback
GOOGLE_MEET_SCOPES="https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/drive.readonly"

# Server
PORT=3001
