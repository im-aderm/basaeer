# Backend Environment Variables
# Copy this file to ".env" and fill in your values.
# See root .env.example for full documentation of each variable.

# ─── Required ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://basaer:CHANGE_ME@localhost:5432/basaer?schema=public

JWT_SECRET=CHANGE_ME_64_CHAR_HEX
JWT_EXPIRES_IN=7d

BOOTSTRAP_SECRET=CHANGE_ME_32_CHAR_HEX
SUPER_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_DEFAULT_PASSWORD=ChangeMeDefault123!

ENCRYPTION_SECRET=CHANGE_ME_64_CHAR_HEX
ENCRYPTION_SALT=basaer-salt-2026

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── SMTP (Email) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME@brevo.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@example.com

# ─── SMS ──────────────────────────────────────────────────────────────────────
TERMII_API_KEY=TL_CHANGE_ME
TERMII_SENDER_ID=Basaer

# ─── Payments ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME
PAYSTACK_PUBLIC_KEY=pk_test_CHANGE_ME

# ─── Google Meet ──────────────────────────────────────────────────────────────
GOOGLE_MEET_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_MEET_CLIENT_SECRET=GOCSPX-CHANGE_ME
GOOGLE_MEET_REDIRECT_URI=http://localhost:3001/api/live-classes/auth/google/callback
GOOGLE_MEET_WEBHOOK_SECRET=CHANGE_ME

# ─── File Uploads (Cloudflare R2) ─────────────────────────────────────────────
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=basaer-uploads
MAX_FILE_SIZE_MB=5

# ─── Database Pool ────────────────────────────────────────────────────────────
DB_POOL_SIZE=20
