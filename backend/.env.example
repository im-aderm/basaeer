# Database
DATABASE_URL="postgresql://user:password@host:port/database"
DIRECT_URL="postgresql://user:password@host:port/database"

# Authentication
JWT_SECRET=your-secure-jwt-secret-here
# JWT_EXPIRATION is currently hardcoded to 60m in auth.module.ts

# Security / Encryption
ENCRYPTION_SECRET=your-strong-encryption-secret-here
ENCRYPTION_SALT=your-encryption-salt-here

# Google Meet Integration
GOOGLE_MEET_CLIENT_ID=your-google-client-id
GOOGLE_MEET_CLIENT_SECRET=your-google-client-secret
GOOGLE_MEET_REDIRECT_URI=https://your-backend-url/api/meet/oauth2callback
GOOGLE_MEET_SCOPES="https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/drive.readonly"

# Server
PORT=3001
