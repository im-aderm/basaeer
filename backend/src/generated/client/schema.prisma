generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id                         String                      @id @default(uuid())
  name                       String
  code                       String                      @unique
  address                    String?
  phone                      String?
  email                      String?
  isActive                   Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  enquiries                  AdmissionEnquiry[]
  alumni                     Alumni[]
  alumniEvents               AlumniEvent[]
  assignments                Assignment[]
  automationConfigs          AutomationConfig[]
  books                      Book[]
  callLogs                   CallLog[]
  accessLogs                 CampusAccessLog[]
  campusEvents               CampusEvent[]
  certificates               Certificate[]
  certificateTemplates       CertificateTemplate[]
  classes                    Class[]
  complaints                 Complaint[]
  conversations              Conversation[]
  deactivationReasons        DeactivationReason[]
  departments                Department[]
  designations               Designation[]
  digitalResources           DigitalResource[]
  expenseCategories          ExpenseCategory[]
  feeCategories              FeeCategory[]
  googleMeetConfig           GoogleMeetConfig?
  hostels                    Hostel[]
  idCardTemplates            IdCardTemplate[]
  inventoryCategories        InventoryCategory[]
  inventoryIssues            InventoryIssue[]
  inventoryProducts          InventoryProduct[]
  inventoryPurchases         InventoryPurchase[]
  inventorySales             InventorySale[]
  inventoryStores            InventoryStore[]
  inventorySuppliers         InventorySupplier[]
  inventoryUnits             InventoryUnit[]
  liveClassSessions          LiveClassSession[]
  loginDeactivations         LoginDeactivation[]
  onlineAdmissions           OnlineAdmission[]
  onlineExams                OnlineExam[]
  postalRecords              PostalRecord[]
  questionGroups             QuestionGroup[]
  students                   Student[]
  studentCategories          StudentCategory[]
  subjects                   Subject[]
  routes                     TransportRoute[]
  users                      User[]
  vehicles                   Vehicle[]
  visitorLogs                VisitorLog[]
  vouchers                   Voucher[]
  academicSessions           AcademicSession[]
  attendance                 Attendance[]
  staffAttendance            StaffAttendance[]
  attendanceSessions         AttendanceSession[]
  attendanceScans            AttendanceScan[]
  assessmentRecords          AssessmentRecord[]
  behaviouralRatings         BehaviouralRating[]
  resultSummaries            ResultSummary[]
  gradingScales              GradingScale[]
  globalSettings             GlobalSetting[]
  moduleConfigurations       ModuleConfiguration[]
  scheduledJobs              ScheduledJob[]
  emailTemplates             EmailTemplate[]
  smsTemplates               SmsTemplate[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  campaigns                  Campaign[]
  campaignRecipients         CampaignRecipient[]
  queueJobLogs               QueueJobLog[]
  automationExecutions       AutomationExecution[]
  messageDeliveryLogs        MessageDeliveryLog[]
  providerHealthLogs         ProviderHealthLog[]
  webhookEvents              WebhookEvent[]
  deliveryWebhookLogs        DeliveryWebhookLog[]
  realtimeConnections        RealtimeConnection[]
  queueMetrics               QueueMetric[]
  providerFailoverEvents     ProviderFailoverEvent[]
  messageRetryEvents         MessageRetryEvent[]
  providerBalanceSnapshots   ProviderBalanceSnapshot[]
  notificationDeliveryEvents NotificationDeliveryEvent[]
  academicExports            AcademicExport[]
  reportTemplates            ReportTemplate[]
}

model DeactivationReason {
  id            String              @id @default(uuid())
  title         String
  description   String?
  branchId      String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  branch        Branch              @relation(fields: [branchId], references: [id])
  deactivations LoginDeactivation[]

  @@index([branchId])
}

model LoginDeactivation {
  id        String              @id @default(uuid())
  studentId String
  userId    String
  reason    String
  reasonId  String?
  branchId  String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  branch    Branch              @relation(fields: [branchId], references: [id])
  reasonRef DeactivationReason? @relation(fields: [reasonId], references: [id])

  @@index([branchId])
}

model User {
  id                         String                    @id @default(uuid())
  email                      String                    @unique
  password                   String
  firstName                  String
  lastName                   String
  phone                      String?
  isActive                   Boolean                   @default(true)
  role                       UserRole
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  branchId                   String?
  resetTokenHash             String?
  resetTokenExpires          DateTime?
  auditLogs                  AuditLog[]
  accessLogs                 CampusAccessLog[]
  realtimeConnections        RealtimeConnection[]
  issuedCertificates         Certificate[]             @relation("IssuedCertificates")
  conversationParticipations ConversationParticipant[]
  digitalResourceLogs        DigitalResourceLog[]
  eventRSVPs                 EventRSVP[]
  meetingParticipations      MeetingParticipant[]
  sentMessages               Message[]
  onlineAdmissions           OnlineAdmission[]         @relation("ParentAdmission")
  staff                      Staff?
  children                   Student[]                 @relation("ParentToStudent")
  student                    Student?
  branch                     Branch?                   @relation(fields: [branchId], references: [id])
  approvedVouchers           Voucher[]                 @relation("VoucherApprover")
  preferences                UserPreference?
  notifications              Notification[]
  notificationPreference     NotificationPreference?
  campaignRecipients         CampaignRecipient[]
  academicExports            AcademicExport[]

  @@index([branchId])
}

model UserPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  theme            String   @default("light")
  language         String   @default("en")
  sidebarCollapsed Boolean  @default(false)
  dashboardWidgets Json?
  notifications    Json?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt        DateTime @updatedAt
}

model ModuleConfiguration {
  id        String   @id @default(uuid())
  moduleKey String
  isEnabled Boolean  @default(true)
  config    Json?
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@unique([moduleKey, branchId])
  @@index([branchId])
}

model Translation {
  id        String   @id @default(uuid())
  locale    String
  group     String   @default("general")
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, group, key])
  @@index([locale, group])
}

model ScheduledJob {
  id         String    @id @default(uuid())
  name       String    @unique
  cron       String
  lastRun    DateTime?
  nextRun    DateTime?
  status     String    @default("IDLE")
  lastResult String?
  errorCount Int       @default(0)
  isEnabled  Boolean   @default(true)
  branchId   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  branch     Branch?   @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model Staff {
  id                 String              @id @default(uuid())
  userId             String              @unique
  designation        String?
  departmentId       String?
  designationId      String?
  status             String              @default("ACTIVE")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  salaryAdvances     AdvanceSalary[]
  assignments        Assignment[]
  classes            Class[]
  classSchedules     ClassSchedule[]
  digitalResources   DigitalResource[]
  idCards            IdCard[]
  inventoryIssues    InventoryIssue[]
  leaveRequests      LeaveRequest[]
  hostedSessions     LiveClassSession[]
  payrolls           Payroll[]
  salaryTemplate     SalaryTemplate?
  department         Department?         @relation(fields: [departmentId], references: [id])
  designationRef     Designation?        @relation(fields: [designationId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  attendance         StaffAttendance[]
  awards             StaffAward[]
  subjects           Subject[]           @relation("StaffToSubject")
  attendanceSessions AttendanceSession[]
}

model Student {
  id                        String               @id @default(uuid())
  userId                    String?              @unique
  firstName                 String
  lastName                  String
  dob                       DateTime?
  branchId                  String
  classId                   String?
  sectionId                 String?
  parentId                  String?
  categoryId                String?
  otherNames                String?
  placeOfBirth              String?
  nationality               String?
  stateOfOrigin             String?
  lga                       String?
  religion                  String?
  passportPhoto             String?
  guardianOccupation        String?
  guardianOfficeAddress     String?
  secondaryGuardianName     String?
  secondaryGuardianPhone    String?
  secondaryGuardianRelation String?
  city                      String?
  state                     String?
  country                   String?
  emergencyContactName      String?
  emergencyContactPhone     String?
  emergencyContactRelation  String?
  bloodGroup                String?
  genotype                  String?
  allergies                 String?
  medicalConditions         String?
  specialNeeds              String?
  familyDoctorName          String?
  familyDoctorPhone         String?
  birthCertificateUrl       String?
  testimonialUrl            String?
  transferCertificateUrl    String?
  immunizationCardUrl       String?
  preferredLanguage         String?
  religionClassType         String?
  scholarshipEligible       Boolean              @default(false)
  referralSource            String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  alumni                    Alumni?
  assessmentRecords         AssessmentRecord[]
  attendance                Attendance[]
  behaviouralRatings        BehaviouralRating[]
  borrowRecords             BorrowRecord[]
  certificates              Certificate[]
  hostelAllocations         HostelAllocation[]
  hostelLeaves              HostelLeave[]
  idCards                   IdCard[]
  inventoryIssues           InventoryIssue[]
  invoices                  Invoice[]
  onlineExamAttempts        OnlineExamAttempt[]
  resultSummaries           ResultSummary[]
  branch                    Branch               @relation(fields: [branchId], references: [id])
  category                  StudentCategory?     @relation(fields: [categoryId], references: [id])
  class                     Class?               @relation(fields: [classId], references: [id])
  parent                    User?                @relation("ParentToStudent", fields: [parentId], references: [id])
  section                   Section?             @relation(fields: [sectionId], references: [id])
  user                      User?                @relation(fields: [userId], references: [id])
  submissions               Submission[]
  transportAssignment       TransportAssignment?
  attendanceScans           AttendanceScan[]

  @@index([branchId])
  @@index([branchId, classId, sectionId])
  @@index([classId, sectionId])
}

model Certificate {
  id                String               @id @default(uuid())
  type              String
  certificateNumber String               @unique
  issueDate         DateTime             @default(now())
  content           Json?
  verificationCode  String               @unique @default(cuid())
  isVerified        Boolean              @default(true)
  studentId         String
  templateId        String?
  issuedByUserId    String
  branchId          String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  branch            Branch               @relation(fields: [branchId], references: [id])
  issuedBy          User                 @relation("IssuedCertificates", fields: [issuedByUserId], references: [id])
  student           Student              @relation(fields: [studentId], references: [id])
  template          CertificateTemplate? @relation(fields: [templateId], references: [id])

  @@index([branchId])
}

model CertificateTemplate {
  id              String        @id @default(uuid())
  name            String
  type            String
  backgroundImage String?
  config          Json
  branchId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  certificates    Certificate[]
  branch          Branch        @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model Class {
  id                 String              @id @default(uuid())
  name               String
  gradeLevel         Int?
  branchId           String
  classTeacherId     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  branch             Branch              @relation(fields: [branchId], references: [id])
  classTeacher       Staff?              @relation(fields: [classTeacherId], references: [id])
  classSchedules     ClassSchedule[]
  digitalResources   DigitalResource[]
  feeStructures      FeeStructure[]
  liveClassSessions  LiveClassSession[]
  onlineAdmissions   OnlineAdmission[]
  onlineExams        OnlineExam[]
  sections           Section[]
  students           Student[]
  attendanceSessions AttendanceSession[]

  @@unique([branchId, name])
  @@index([branchId])
}

model Section {
  id                 String              @id @default(uuid())
  name               String
  classId            String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assessmentRecords  AssessmentRecord[]
  assignments        Assignment[]
  attendance         Attendance[]
  classSchedules     ClassSchedule[]
  digitalResources   DigitalResource[]
  liveClassSessions  LiveClassSession[]
  onlineAdmissions   OnlineAdmission[]
  onlineExams        OnlineExam[]
  class              Class               @relation(fields: [classId], references: [id])
  students           Student[]
  attendanceSessions AttendanceSession[]

  @@unique([classId, name])
  @@index([classId])
}

model Subject {
  id                 String              @id @default(uuid())
  name               String
  code               String?
  branchId           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assessmentRecords  AssessmentRecord[]
  assignments        Assignment[]
  classSchedules     ClassSchedule[]
  digitalResources   DigitalResource[]
  liveClassSessions  LiveClassSession[]
  onlineExams        OnlineExam[]
  branch             Branch              @relation(fields: [branchId], references: [id])
  teachers           Staff[]             @relation("StaffToSubject")
  attendanceSessions AttendanceSession[]

  @@index([branchId])
}

model ClassSchedule {
  id        String   @id @default(uuid())
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?
  classId   String
  sectionId String
  subjectId String
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id])
  section   Section  @relation(fields: [sectionId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacher   Staff    @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, dayOfWeek, startTime])
  @@unique([classId, sectionId, dayOfWeek, startTime])
  @@index([classId, sectionId])
}

model Attendance {
  id        String             @id @default(uuid())
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  studentId String
  sectionId String?
  sessionId String?
  branchId  String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  branch    Branch             @relation(fields: [branchId], references: [id])
  section   Section?           @relation(fields: [sectionId], references: [id])
  student   Student            @relation(fields: [studentId], references: [id])
  session   AttendanceSession? @relation(fields: [sessionId], references: [id])

  @@unique([studentId, date, sessionId])
  @@index([branchId])
  @@index([branchId, sectionId, date])
  @@index([sectionId, date])
  @@index([sessionId])
  @@index([studentId, date])
  @@index([branchId, date])
}

model StaffAttendance {
  id        String           @id @default(uuid())
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  staffId   String
  branchId  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  branch    Branch           @relation(fields: [branchId], references: [id])
  staff     Staff            @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@index([branchId])
  @@index([branchId, date])
  @@index([staffId, date])
}

model Hostel {
  id        String     @id @default(uuid())
  name      String
  type      HostelType
  address   String?
  branchId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  branch    Branch     @relation(fields: [branchId], references: [id])
  rooms     Room[]

  @@index([branchId])
}

model Room {
  id        String   @id @default(uuid())
  number    String
  floor     Int
  capacity  Int
  hostelId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  beds      Bed[]
  hostel    Hostel   @relation(fields: [hostelId], references: [id])

  @@unique([hostelId, number])
}

model Bed {
  id          String               @id @default(uuid())
  name        String
  status      BedStatus            @default(AVAILABLE)
  roomId      String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  room        Room                 @relation(fields: [roomId], references: [id])
  allocations HostelAllocation[]
  maintenance MaintenanceRequest[]

  @@unique([roomId, name])
}

model HostelAllocation {
  id           String    @id @default(uuid())
  checkInDate  DateTime
  checkOutDate DateTime?
  isActive     Boolean   @default(true)
  studentId    String
  bedId        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bed          Bed       @relation(fields: [bedId], references: [id])
  student      Student   @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model HostelLeave {
  id        String   @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  reason    String
  status    String   @default("PENDING")
  studentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model MaintenanceRequest {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String   @default("OPEN")
  priority    String   @default("MEDIUM")
  bedId       String?
  roomId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bed         Bed?     @relation(fields: [bedId], references: [id])
}

model FeeCategory {
  id            String         @id @default(uuid())
  name          String
  description   String?
  branchId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  branch        Branch         @relation(fields: [branchId], references: [id])
  feeStructures FeeStructure[]
  invoiceItems  InvoiceItem[]

  @@index([branchId])
}

model FeeStructure {
  id         String      @id @default(uuid())
  amount     Float
  categoryId String
  classId    String?
  branchId   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  category   FeeCategory @relation(fields: [categoryId], references: [id])
  class      Class?      @relation(fields: [classId], references: [id])

  @@index([branchId])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  dueDate       DateTime
  totalAmount   Float
  balance       Float
  status        InvoiceStatus @default(UNPAID)
  studentId     String
  branchId      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  student       Student       @relation(fields: [studentId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]

  @@index([branchId])
  @@index([studentId])
}

model QuestionGroup {
  id        String       @id @default(uuid())
  name      String
  branchId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  exams     OnlineExam[]
  questions Question[]
  branch    Branch       @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model Question {
  id        String           @id @default(uuid())
  type      QuestionType
  content   String
  marks     Float            @default(1.0)
  groupId   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  group     QuestionGroup    @relation(fields: [groupId], references: [id])
  answers   QuestionAnswer[]
  options   QuestionOption[]

  @@index([groupId])
}

model QuestionOption {
  id         String   @id @default(uuid())
  content    String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model OnlineExam {
  id              String              @id @default(uuid())
  title           String
  description     String?
  scheduledDate   DateTime
  durationMinutes Int
  passPercentage  Float               @default(40.0)
  status          ExamStatus          @default(PUBLISHED)
  classId         String
  sectionId       String?
  subjectId       String
  groupId         String
  branchId        String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  branch          Branch              @relation(fields: [branchId], references: [id])
  class           Class               @relation(fields: [classId], references: [id])
  group           QuestionGroup       @relation(fields: [groupId], references: [id])
  section         Section?            @relation(fields: [sectionId], references: [id])
  subject         Subject             @relation(fields: [subjectId], references: [id])
  attempts        OnlineExamAttempt[]

  @@index([branchId])
}

model OnlineExamAttempt {
  id        String           @id @default(uuid())
  examId    String
  studentId String
  startTime DateTime         @default(now())
  endTime   DateTime?
  score     Float?
  position  Int?
  status    AttemptStatus    @default(IN_PROGRESS)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  exam      OnlineExam       @relation(fields: [examId], references: [id])
  student   Student          @relation(fields: [studentId], references: [id])
  answers   QuestionAnswer[]

  @@unique([examId, studentId])
  @@index([studentId])
}

model QuestionAnswer {
  id               String            @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  textAnswer       String?
  marksAwarded     Float?
  isCorrect        Boolean?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attempt          OnlineExamAttempt @relation(fields: [attemptId], references: [id])
  question         Question          @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model InvoiceItem {
  id         String      @id @default(uuid())
  amount     Float
  invoiceId  String
  categoryId String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  category   FeeCategory @relation(fields: [categoryId], references: [id])
  invoice    Invoice     @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(uuid())
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  proofUrl      String?
  notes         String?
  invoiceId     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model Vehicle {
  id                 String                @id @default(uuid())
  registrationNumber String                @unique
  model              String
  capacity           Int
  driverName         String
  driverPhone        String?
  branchId           String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  assignments        TransportAssignment[]
  branch             Branch                @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model TransportRoute {
  id          String                @id @default(uuid())
  name        String
  startPoint  String
  endPoint    String
  stops       Json?
  branchId    String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  assignments TransportAssignment[]
  branch      Branch                @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model TransportAssignment {
  id        String         @id @default(uuid())
  studentId String         @unique
  vehicleId String
  routeId   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  route     TransportRoute @relation(fields: [routeId], references: [id])
  student   Student        @relation(fields: [studentId], references: [id])
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id])
}

model Assignment {
  id            String       @id @default(uuid())
  title         String
  description   String?
  dueDate       DateTime
  attachmentUrl String?
  subjectId     String
  sectionId     String
  teacherId     String?
  branchId      String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  branch        Branch       @relation(fields: [branchId], references: [id])
  section       Section      @relation(fields: [sectionId], references: [id])
  subject       Subject      @relation(fields: [subjectId], references: [id])
  teacher       Staff?       @relation(fields: [teacherId], references: [id])
  submissions   Submission[]

  @@index([branchId])
}

model Submission {
  id           String     @id @default(uuid())
  contentUrl   String?
  grade        Float?
  feedback     String?
  status       String     @default("SUBMITTED")
  assignmentId String
  studentId    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
}

model AcademicSession {
  id                 String              @id @default(uuid())
  name               String
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean             @default(true)
  nextTermBegins     DateTime?
  termEnds           DateTime?
  branchId           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  branch             Branch              @relation(fields: [branchId], references: [id])
  assessmentRecords  AssessmentRecord[]
  behaviouralRatings BehaviouralRating[]
