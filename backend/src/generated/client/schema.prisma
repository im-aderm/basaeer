  name             String
  phone            String
  date             DateTime  @default(now())
  description      String?
  nextFollowUpDate DateTime?
  callType         String    @default("INCOMING") // INCOMING, OUTGOING

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

