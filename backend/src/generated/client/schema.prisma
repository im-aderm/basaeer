  branch        Branch              @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model InventoryUnit {
  id        String             @id @default(uuid())
  name      String
  branchId  String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  products  InventoryProduct[]
  branch    Branch             @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model InventoryProduct {
  id           String              @id @default(uuid())
  name         String
  code         String?             @unique
  description  String?
  categoryId   String
  unitId       String
  storeId      String?
  stock        Int                 @default(0)
  costPrice    Float               @default(0)
  sellingPrice Float               @default(0)
  branchId     String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  issues       InventoryIssue[]
  branch       Branch              @relation(fields: [branchId], references: [id])
  category     InventoryCategory   @relation(fields: [categoryId], references: [id])
  store        InventoryStore?     @relation(fields: [storeId], references: [id])
  unit         InventoryUnit       @relation(fields: [unitId], references: [id])
  purchases    InventoryPurchase[]
  sales        InventorySale[]

  @@index([branchId])
}

model InventoryPurchase {
  id         String            @id @default(uuid())
  voucherNo  String?           @unique
  date       DateTime          @default(now())
  quantity   Int
  unitPrice  Float
  totalPrice Float
  productId  String
  supplierId String
  branchId   String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  branch     Branch            @relation(fields: [branchId], references: [id])
  product    InventoryProduct  @relation(fields: [productId], references: [id])
  supplier   InventorySupplier @relation(fields: [supplierId], references: [id])

  @@index([branchId])
}

model InventorySale {
  id           String           @id @default(uuid())
  invoiceNo    String?          @unique
  date         DateTime         @default(now())
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  productId    String
  customerName String?
  branchId     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  branch       Branch           @relation(fields: [branchId], references: [id])
  product      InventoryProduct @relation(fields: [productId], references: [id])

  @@index([branchId])
}

model InventoryIssue {
  id         String           @id @default(uuid())
  date       DateTime         @default(now())
  returnDate DateTime?
  quantity   Int
  status     String           @default("ISSUED")
  productId  String
  issuedTo   String?
  staffId    String?
  studentId  String?
  branchId   String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  branch     Branch           @relation(fields: [branchId], references: [id])
  product    InventoryProduct @relation(fields: [productId], references: [id])
  staff      Staff?           @relation(fields: [staffId], references: [id])
  student    Student?         @relation(fields: [studentId], references: [id])

  @@index([branchId])
}

model Alumni {
  id                String                   @id @default(uuid())
  studentId         String                   @unique
  graduationDate    DateTime
  currentOccupation String?
  currentCompany    String?
  higherEducation   String?
  linkedInUrl       String?
  isPublic          Boolean                  @default(true)
  branchId          String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  branch            Branch                   @relation(fields: [branchId], references: [id])
  student           Student                  @relation(fields: [studentId], references: [id])
  events            AlumniEventParticipant[]

  @@index([branchId])
}

model AlumniEvent {
  id           String                   @id @default(uuid())
  title        String
  description  String?
  eventDate    DateTime
  location     String?
  isOnline     Boolean                  @default(false)
  meetingUrl   String?
  branchId     String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  branch       Branch                   @relation(fields: [branchId], references: [id])
  participants AlumniEventParticipant[]

  @@index([branchId])
}

model AlumniEventParticipant {
  id        String      @id @default(uuid())
  alumniId  String
  eventId   String
  status    String      @default("INTERESTED")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  alumni    Alumni      @relation(fields: [alumniId], references: [id])
  event     AlumniEvent @relation(fields: [eventId], references: [id])

  @@unique([alumniId, eventId])
}

model Conversation {
  id            String                    @id @default(uuid())
  title         String?
  lastMessageAt DateTime                  @default(now())
  branchId      String
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  branch        Branch                    @relation(fields: [branchId], references: [id])
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([branchId])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  unreadCount    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  conversationId String
  senderId       String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
}

model CampusEvent {
  id          String      @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  location    String?
  category    String
  isPublic    Boolean     @default(true)
  allowRSVP   Boolean     @default(true)
  branchId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  branch      Branch      @relation(fields: [branchId], references: [id])
  rsvps       EventRSVP[]

  @@index([branchId])
}

model EventRSVP {
  id        String      @id @default(uuid())
  eventId   String
  userId    String
  status    String      @default("INTERESTED")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  event     CampusEvent @relation(fields: [eventId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model CampusAccessLog {
  id         String   @id @default(uuid())
  userId     String
  scanTime   DateTime @default(now())
  direction  String
  location   String?
  deviceInfo String?
  branchId   String
  createdAt  DateTime @default(now())
  branch     Branch   @relation(fields: [branchId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([branchId])
}

model AutomationConfig {
  id          String                @id @default(uuid())
  type        String
  isEnabled   Boolean               @default(true)
  template    String?
  triggerDays Int?
  lastRun     DateTime?
  branchId    String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  branch      Branch                @relation(fields: [branchId], references: [id])
  executions  AutomationExecution[]

  @@unique([branchId, type])
  @@index([branchId])
}

model IdCardTemplate {
  id              String   @id @default(uuid())
  name            String
  type            String
  backgroundImage String?
  config          Json
  branchId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  idCards         IdCard[]
  branch          Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model IdCard {
  id         String          @id @default(uuid())
  studentId  String?
  staffId    String?
  templateId String
  sessionId  String
  status     String          @default("CREATED")
  issueDate  DateTime        @default(now())
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  session    AcademicSession @relation(fields: [sessionId], references: [id])
  staff      Staff?          @relation(fields: [staffId], references: [id])
  student    Student?        @relation(fields: [studentId], references: [id])
  template   IdCardTemplate  @relation(fields: [templateId], references: [id])

  @@unique([studentId, sessionId])
}

model DigitalResource {
  id           String               @id @default(uuid())
  title        String
  description  String?
  fileUrl      String
  fileType     String
  fileSize     Int?
  thumbnailUrl String?
  category     String
  sessionId    String
  classId      String?
  sectionId    String?
  subjectId    String?
  uploaderId   String
  branchId     String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  branch       Branch               @relation(fields: [branchId], references: [id])
  class        Class?               @relation(fields: [classId], references: [id])
  section      Section?             @relation(fields: [sectionId], references: [id])
  session      AcademicSession      @relation(fields: [sessionId], references: [id])
  subject      Subject?             @relation(fields: [subjectId], references: [id])
  uploader     Staff                @relation(fields: [uploaderId], references: [id])
  logs         DigitalResourceLog[]

  @@index([branchId, category])
  @@index([classId, subjectId])
  @@index([branchId])
}

model DigitalResourceLog {
  id         String          @id @default(uuid())
  resourceId String
  userId     String
  action     String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime        @default(now())
  resource   DigitalResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id])

  @@index([resourceId])
}

