model EmailTemplate {
  id        String   @id @default(uuid())
  name      String
  subject   String
  body      String
  variables Json?
  type      String
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model SmsTemplate {
  id        String   @id @default(uuid())
  name      String
  content   String
  variables Json?
  type      String
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch?  @relation(fields: [branchId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([userId])
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  email     Boolean  @default(true)
  sms       Boolean  @default(true)
  inApp     Boolean  @default(true)
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch?  @relation(fields: [branchId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([branchId])
}

model Campaign {
  id          String              @id @default(uuid())
  name        String
  type        String
  status      String
  scheduledAt DateTime?
  branchId    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  branch      Branch?             @relation(fields: [branchId], references: [id])
  recipients  CampaignRecipient[]

  @@index([branchId])
}

model CampaignRecipient {
  id          String   @id @default(uuid())
  campaignId  String
  userId      String?
  status      String
  deliveryLog String?
  branchId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
  branch      Branch?  @relation(fields: [branchId], references: [id])

  @@index([campaignId])
  @@index([userId])
  @@index([branchId])
}

model AttendanceSession {
  id        String           @id @default(uuid())
  name      String? // e.g. "Morning Session", "Afternoon Session", "Mathematics Period"
  date      DateTime
  startTime DateTime?
  endTime   DateTime?
  classId   String?
  sectionId String?
  subjectId String?
  teacherId String?
  branchId  String
  isActive  Boolean          @default(true)
  isLocked  Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  branch    Branch           @relation(fields: [branchId], references: [id])
  class     Class?           @relation(fields: [classId], references: [id])
  section   Section?         @relation(fields: [sectionId], references: [id])
  subject   Subject?         @relation(fields: [subjectId], references: [id])
  teacher   Staff?           @relation(fields: [teacherId], references: [id])
  records   Attendance[]
  scans     AttendanceScan[]

  @@index([branchId, date])
  @@index([sectionId, date])
  @@index([teacherId, date])
  @@index([classId, date])
  @@index([subjectId, date])
}

model AttendanceScan {
  id         String            @id @default(uuid())
  studentId  String
  sessionId  String
  scanTime   DateTime          @default(now())
  deviceInfo String?
  ipAddress  String?
  isOffline  Boolean           @default(false)
  branchId   String
  branch     Branch            @relation(fields: [branchId], references: [id])
  session    AttendanceSession @relation(fields: [sessionId], references: [id])
  student    Student           @relation(fields: [studentId], references: [id])

  @@index([branchId])
  @@index([sessionId])
  @@index([studentId])
  @@index([studentId, scanTime])
}

model QueueJobLog {
  id        String   @id @default(uuid())
  jobId     String
  queueName String
  name      String
  status    String
  data      Json?
  result    Json?
  error     String?
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([jobId])
}

model AutomationExecution {
  id         String           @id @default(uuid())
  configId   String
  status     String
  executedAt DateTime         @default(now())
  result     String?
  branchId   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  config     AutomationConfig @relation(fields: [configId], references: [id])
  branch     Branch?          @relation(fields: [branchId], references: [id])

  @@index([configId])
  @@index([branchId])
}

model MessageDeliveryLog {
  id               String   @id @default(uuid())
  type             String
  recipient        String
  status           String
  providerResponse Json?
  branchId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  branch           Branch?  @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model ProviderHealthLog {
  id           String   @id @default(uuid())
  providerType String // SMS, EMAIL, PUSH
  providerName String
  status       String // UP, DOWN, DEGRADED
  latency      Int? // in ms
  error        String?
  branchId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branch       Branch?  @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model WebhookEvent {
  id           String   @id @default(uuid())
  providerName String
  payload      Json
  eventType    String
  status       String   @default("PENDING") // PENDING, PROCESSED, FAILED
  error        String?
  branchId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branch       Branch?  @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model DeliveryWebhookLog {
  id                String   @id @default(uuid())
  messageId         String
  providerMessageId String?
  status            String
  payload           Json
  branchId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  branch            Branch?  @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([messageId])
}

model RealtimeConnection {
  id         String   @id @default(uuid())
  userId     String
  socketId   String   @unique
  deviceInfo String?
  branchId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  branch     Branch?  @relation(fields: [branchId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([userId])
}

model QueueMetric {
  id             String   @id @default(uuid())
  queueName      String
  waitingCount   Int
  activeCount    Int
  completedCount Int
  failedCount    Int
  delayedCount   Int
  branchId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch?  @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model ProviderFailoverEvent {
  id             String   @id @default(uuid())
  failedProvider String
  targetProvider String
  reason         String?
  providerType   String // SMS, EMAIL
  branchId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch?  @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model MessageRetryEvent {
  id          String    @id @default(uuid())
  messageId   String
  retryCount  Int
  error       String?
  nextRetryAt DateTime?
  status      String // PENDING, SUCCESS, FAILED
  branchId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  branch      Branch?   @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([messageId])
}

model ProviderBalanceSnapshot {
  id           String   @id @default(uuid())
  providerName String
  balance      Float
  currency     String   @default("NGN")
  branchId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branch       Branch?  @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model NotificationDeliveryEvent {
  id             String   @id @default(uuid())
  notificationId String
  channel        String // SMS, EMAIL, IN_APP
  status         String // SENT, DELIVERED, FAILED
  error          String?
  branchId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch?  @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([notificationId])
}

model AcademicExport {
  id         String    @id @default(uuid())
  type       String // REPORT_CARD, TRANSCRIPT, BROADSHEET, ANALYTICS, CSV, EXCEL
  status     String    @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED, EXPIRED, CANCELLED
  progress   Int       @default(0)
  fileUrl    String?
  fileName   String?
  fileSize   Int?
  error      String?
  parameters Json?
  userId     String
  branchId   String
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([userId])
  @@index([status])
}

model ReportTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String   @default("STUDENT_REPORT") // STUDENT_REPORT, TAHFEEZ_REPORT, etc.
  layout      Json // Dynamic sections, fields, positions
  config      Json // Colors, fonts, margins, branding
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  branchId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
}
