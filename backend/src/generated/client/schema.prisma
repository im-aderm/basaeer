model PostalRecord {
  id              String   @id @default(uuid())
  fromTitle       String
  toTitle         String
  referenceNumber String?
  address         String?
  description     String?
  date            DateTime @default(now())
  type            String // DISPATCH, RECEIVE

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// INVENTORY MANAGEMENT MODULE (PHASE 16)
// ============================================

model InventoryCategory {
  id        String             @id @default(uuid())
  name      String
  branchId  String
  branch    Branch             @relation(fields: [branchId], references: [id])
  products  InventoryProduct[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model InventoryStore {
  id        String             @id @default(uuid())
  name      String
  code      String?            @unique
  branchId  String
  branch    Branch             @relation(fields: [branchId], references: [id])
  products  InventoryProduct[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model InventorySupplier {
  id            String              @id @default(uuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  branchId      String
  branch        Branch              @relation(fields: [branchId], references: [id])
  purchases     InventoryPurchase[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model InventoryUnit {
  id        String             @id @default(uuid())
  name      String // e.g. "Pcs", "Kg", "Box"
  branchId  String
  branch    Branch             @relation(fields: [branchId], references: [id])
  products  InventoryProduct[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model InventoryProduct {
  id          String  @id @default(uuid())
  name        String
  code        String? @unique
  description String?

  categoryId String
  category   InventoryCategory @relation(fields: [categoryId], references: [id])

  unitId String
  unit   InventoryUnit @relation(fields: [unitId], references: [id])

  storeId String?
  store   InventoryStore? @relation(fields: [storeId], references: [id])

  stock Int @default(0)

  purchases InventoryPurchase[]
  sales     InventorySale[]
  issues    InventoryIssue[]

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryPurchase {
  id         String   @id @default(uuid())
  voucherNo  String?  @unique
  date       DateTime @default(now())
  quantity   Int
  unitPrice  Float
  totalPrice Float

  productId String
  product   InventoryProduct @relation(fields: [productId], references: [id])

  supplierId String
  supplier   InventorySupplier @relation(fields: [supplierId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventorySale {
  id         String   @id @default(uuid())
  invoiceNo  String?  @unique
  date       DateTime @default(now())
  quantity   Int
  unitPrice  Float
  totalPrice Float

  productId String
  product   InventoryProduct @relation(fields: [productId], references: [id])

  customerName String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryIssue {
  id         String    @id @default(uuid())
  date       DateTime  @default(now())
  returnDate DateTime?
  quantity   Int
  status     String    @default("ISSUED") // ISSUED, RETURNED

  productId String
  product   InventoryProduct @relation(fields: [productId], references: [id])

  issuedTo String?

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id])

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// STAKEHOLDER ECOSYSTEM (PHASE 17)
// ============================================

model Alumni {
  id        String  @id @default(uuid())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id])

  graduationDate    DateTime
  currentOccupation String?
  currentCompany    String?
  higherEducation   String?
  linkedInUrl       String?
  isPublic          Boolean  @default(true)

  events AlumniEventParticipant[]

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AlumniEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  eventDate   DateTime
  location    String?
  isOnline    Boolean  @default(false)
  meetingUrl  String?

  participants AlumniEventParticipant[]

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AlumniEventParticipant {
  id       String      @id @default(uuid())
  alumniId String
  alumni   Alumni      @relation(fields: [alumniId], references: [id])
  eventId  String
  event    AlumniEvent @relation(fields: [eventId], references: [id])
  status   String      @default("INTERESTED") // INTERESTED, GOING, DECLINED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([alumniId, eventId])
}

model Conversation {
  id            String   @id @default(uuid())
  title         String?
  lastMessageAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  unreadCount    Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  isRead         Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// CAMPUS AUTOMATION & EVENTS (PHASE 18)
// ============================================

model CampusEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  location    String?
  category    String // e.g., ACADEMIC, HOLIDAY, SPORTS, CULTURAL
  isPublic    Boolean  @default(true)
  allowRSVP   Boolean  @default(true)

  rsvps EventRSVP[]

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventRSVP {
  id      String      @id @default(uuid())
  eventId String
  event   CampusEvent @relation(fields: [eventId], references: [id])
  userId  String
  user    User        @relation(fields: [userId], references: [id])
  status  String      @default("INTERESTED") // INTERESTED, GOING, DECLINED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
}

model CampusAccessLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  scanTime   DateTime @default(now())
  direction  String // ENTRY, EXIT
  location   String? // e.g., Main Gate, Library
  deviceInfo String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
}

model AutomationConfig {
  id          String    @id @default(uuid())
  type        String // BIRTHDAY_WISH, FEE_REMINDER, ATTENDANCE_ALERT
  isEnabled   Boolean   @default(true)
  template    String? // Message template
  triggerDays Int? // Days before/after event
  lastRun     DateTime?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, type])
}

// ============================================
// CARD MANAGEMENT MODULE (PHASE 20)
// ============================================

model IdCardTemplate {
  id              String  @id @default(uuid())
  name            String
  type            String // STUDENT, EMPLOYEE, ADMIT
  backgroundImage String? // URL to background image

  // Field positions and styling (stored as JSON)
  // e.g. { "name": { "x": 10, "y": 20, "fontSize": 12, "color": "#000" } }
  config Json

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  idCards IdCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IdCard {
  id        String   @id @default(uuid())
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id])

  templateId String
  template   IdCardTemplate @relation(fields: [templateId], references: [id])

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id])

  status    String   @default("CREATED") // CREATED, EXPIRED
  issueDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, sessionId])
}

// ============================================
// ATTACHMENT BOOK (DIGITAL LIBRARY) MODULE
// ============================================

model DigitalResource {
  id           String  @id @default(uuid())
  title        String
  description  String?
  fileUrl      String // URL to the file in storage
  fileType     String // e.g. PDF, DOCX, URL
  fileSize     Int? // in bytes
  thumbnailUrl String? // Optional thumbnail for the resource

  category String // TEXTBOOK, NOTE, WORKSHEET, REFERENCE, LINK

  // Academic Mapping
  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id])

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  uploaderId String
  uploader   Staff  @relation(fields: [uploaderId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  logs DigitalResourceLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, category])
  @@index([classId, subjectId])
}

model DigitalResourceLog {
  id         String          @id @default(uuid())
  resourceId String
  resource   DigitalResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  action    String // VIEW, DOWNLOAD
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
}
