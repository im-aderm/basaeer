generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id                   String                @id @default(uuid())
  name                 String
  code                 String                @unique
  address              String?
  phone                String?
  email                String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  enquiries            AdmissionEnquiry[]
  alumni               Alumni[]
  alumniEvents         AlumniEvent[]
  assignments          Assignment[]
  automationConfigs    AutomationConfig[]
  books                Book[]
  callLogs             CallLog[]
  accessLogs           CampusAccessLog[]
  campusEvents         CampusEvent[]
  certificates         Certificate[]
  certificateTemplates CertificateTemplate[]
  classes              Class[]
  complaints           Complaint[]
  conversations        Conversation[]
  deactivationReasons  DeactivationReason[]
  departments          Department[]
  designations         Designation[]
  digitalResources     DigitalResource[]
  expenseCategories    ExpenseCategory[]
  feeCategories        FeeCategory[]
  googleMeetConfig     GoogleMeetConfig?
  hostels              Hostel[]
  idCardTemplates      IdCardTemplate[]
  inventoryCategories  InventoryCategory[]
  inventoryIssues      InventoryIssue[]
  inventoryProducts    InventoryProduct[]
  inventoryPurchases   InventoryPurchase[]
  inventorySales       InventorySale[]
  inventoryStores      InventoryStore[]
  inventorySuppliers   InventorySupplier[]
  inventoryUnits       InventoryUnit[]
  liveClassSessions    LiveClassSession[]
  loginDeactivations   LoginDeactivation[]
  onlineAdmissions     OnlineAdmission[]
  onlineExams          OnlineExam[]
  postalRecords        PostalRecord[]
  questionGroups       QuestionGroup[]
  students             Student[]
  studentCategories    StudentCategory[]
  subjects             Subject[]
  routes               TransportRoute[]
  users                User[]
  vehicles             Vehicle[]
  visitorLogs          VisitorLog[]
  vouchers             Voucher[]
  academicSessions     AcademicSession[]
  attendance           Attendance[]
  staffAttendance      StaffAttendance[]
  assessmentRecords    AssessmentRecord[]
  behaviouralRatings   BehaviouralRating[]
  resultSummaries      ResultSummary[]
  gradingScales        GradingScale[]
  globalSettings       GlobalSetting[]
}

model DeactivationReason {
  id            String              @id @default(uuid())
  title         String
  description   String?
  branchId      String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  branch        Branch              @relation(fields: [branchId], references: [id])
  deactivations LoginDeactivation[]
}

model LoginDeactivation {
  id        String              @id @default(uuid())
  studentId String
  userId    String
  reason    String
  reasonId  String?
  branchId  String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  branch    Branch              @relation(fields: [branchId], references: [id])
  reasonRef DeactivationReason? @relation(fields: [reasonId], references: [id])
}

model User {
  id                         String                    @id @default(uuid())
  email                      String                    @unique
  password                   String
  firstName                  String
  lastName                   String
  phone                      String?
  isActive                   Boolean                   @default(true)
  role                       UserRole
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  branchId                   String?
  auditLogs                  AuditLog[]
  accessLogs                 CampusAccessLog[]
  issuedCertificates         Certificate[]             @relation("IssuedCertificates")
  conversationParticipations ConversationParticipant[]
  digitalResourceLogs        DigitalResourceLog[]
  eventRSVPs                 EventRSVP[]
  meetingParticipations      MeetingParticipant[]
  sentMessages               Message[]
  onlineAdmissions           OnlineAdmission[]         @relation("ParentAdmission")
  staff                      Staff?
  children                   Student[]                 @relation("ParentToStudent")
  student                    Student?
  branch                     Branch?                   @relation(fields: [branchId], references: [id])
  approvedVouchers           Voucher[]                 @relation("VoucherApprover")
}

model Staff {
  id               String             @id @default(uuid())
  userId           String             @unique
  designation      String?
  departmentId     String?
  designationId    String?
  status           String             @default("ACTIVE")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  salaryAdvances   AdvanceSalary[]
  assignments      Assignment[]
  classes          Class[]
  classSchedules   ClassSchedule[]
  digitalResources DigitalResource[]
  idCards          IdCard[]
  inventoryIssues  InventoryIssue[]
  leaveRequests    LeaveRequest[]
  hostedSessions   LiveClassSession[]
  payrolls         Payroll[]
  salaryTemplate   SalaryTemplate?
  department       Department?        @relation(fields: [departmentId], references: [id])
  designationRef   Designation?       @relation(fields: [designationId], references: [id])
  user             User               @relation(fields: [userId], references: [id])
  attendance       StaffAttendance[]
  awards           StaffAward[]
  subjects         Subject[]          @relation("StaffToSubject")
}

model Student {
  id                        String               @id @default(uuid())
  userId                    String?              @unique
  firstName                 String
  lastName                  String
  dob                       DateTime?
  branchId                  String
  classId                   String?
  sectionId                 String?
  parentId                  String?
  categoryId                String?
  otherNames                String?
  placeOfBirth              String?
  nationality               String?
  stateOfOrigin             String?
  lga                       String?
  religion                  String?
  passportPhoto             String?
  guardianOccupation        String?
  guardianOfficeAddress     String?
  secondaryGuardianName     String?
  secondaryGuardianPhone    String?
  secondaryGuardianRelation String?
  city                      String?
  state                     String?
  country                   String?
  emergencyContactName      String?
  emergencyContactPhone     String?
  emergencyContactRelation  String?
  bloodGroup                String?
  genotype                  String?
  allergies                 String?
  medicalConditions         String?
  specialNeeds              String?
  familyDoctorName          String?
  familyDoctorPhone         String?
  birthCertificateUrl       String?
  testimonialUrl            String?
  transferCertificateUrl    String?
  immunizationCardUrl       String?
  preferredLanguage         String?
  religionClassType         String?
  scholarshipEligible       Boolean              @default(false)
  referralSource            String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  alumni                    Alumni?
  assessmentRecords         AssessmentRecord[]
  attendance                Attendance[]
  behaviouralRatings        BehaviouralRating[]
  borrowRecords             BorrowRecord[]
  certificates              Certificate[]
  hostelAllocations         HostelAllocation[]
  hostelLeaves              HostelLeave[]
  idCards                   IdCard[]
  inventoryIssues           InventoryIssue[]
  invoices                  Invoice[]
  onlineExamAttempts        OnlineExamAttempt[]
  resultSummaries           ResultSummary[]
  branch                    Branch               @relation(fields: [branchId], references: [id])
  category                  StudentCategory?     @relation(fields: [categoryId], references: [id])
  class                     Class?               @relation(fields: [classId], references: [id])
  parent                    User?                @relation("ParentToStudent", fields: [parentId], references: [id])
  section                   Section?             @relation(fields: [sectionId], references: [id])
  user                      User?                @relation(fields: [userId], references: [id])
  submissions               Submission[]
  transportAssignment       TransportAssignment?
}

model Certificate {
  id                String               @id @default(uuid())
  type              String
  certificateNumber String               @unique
  issueDate         DateTime             @default(now())
  content           Json?
  verificationCode  String               @unique @default(cuid())
  isVerified        Boolean              @default(true)
  studentId         String
  templateId        String?
  issuedByUserId    String
  branchId          String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  branch            Branch               @relation(fields: [branchId], references: [id])
  issuedBy          User                 @relation("IssuedCertificates", fields: [issuedByUserId], references: [id])
  student           Student              @relation(fields: [studentId], references: [id])
  template          CertificateTemplate? @relation(fields: [templateId], references: [id])
}

model CertificateTemplate {
  id              String        @id @default(uuid())
  name            String
  type            String
  backgroundImage String?
  config          Json
  branchId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  certificates    Certificate[]
  branch          Branch        @relation(fields: [branchId], references: [id])
}

model Class {
  id                String             @id @default(uuid())
  name              String
  gradeLevel        Int?
  branchId          String
  classTeacherId    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  branch            Branch             @relation(fields: [branchId], references: [id])
  classTeacher      Staff?             @relation(fields: [classTeacherId], references: [id])
  classSchedules    ClassSchedule[]
  digitalResources  DigitalResource[]
  feeStructures     FeeStructure[]
  liveClassSessions LiveClassSession[]
  onlineAdmissions  OnlineAdmission[]
  onlineExams       OnlineExam[]
  sections          Section[]
  students          Student[]

  @@unique([branchId, name])
}

model Section {
  id                String             @id @default(uuid())
  name              String
  classId           String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  assessmentRecords AssessmentRecord[]
  assignments       Assignment[]
  attendance        Attendance[]
  classSchedules    ClassSchedule[]
  digitalResources  DigitalResource[]
  liveClassSessions LiveClassSession[]
  onlineAdmissions  OnlineAdmission[]
  onlineExams       OnlineExam[]
  class             Class              @relation(fields: [classId], references: [id])
  students          Student[]

  @@unique([classId, name])
}

model Subject {
  id                String             @id @default(uuid())
  name              String
  code              String?
  branchId          String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  assessmentRecords AssessmentRecord[]
  assignments       Assignment[]
  classSchedules    ClassSchedule[]
  digitalResources  DigitalResource[]
  liveClassSessions LiveClassSession[]
  onlineExams       OnlineExam[]
  branch            Branch             @relation(fields: [branchId], references: [id])
  teachers          Staff[]            @relation("StaffToSubject")
}

model ClassSchedule {
  id        String   @id @default(uuid())
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?
  classId   String
  sectionId String
  subjectId String
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id])
  section   Section  @relation(fields: [sectionId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacher   Staff    @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, dayOfWeek, startTime])
  @@unique([classId, sectionId, dayOfWeek, startTime])
}

model Attendance {
  id        String           @id @default(uuid())
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  studentId String
  sectionId String?
  branchId  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  branch    Branch           @relation(fields: [branchId], references: [id])
  section   Section?         @relation(fields: [sectionId], references: [id])
  student   Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
  @@index([branchId])
}

model StaffAttendance {
  id        String           @id @default(uuid())
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  staffId   String
  branchId  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  branch    Branch           @relation(fields: [branchId], references: [id])
  staff     Staff            @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@index([branchId])
}

model Hostel {
  id        String     @id @default(uuid())
  name      String
  type      HostelType
  address   String?
  branchId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  branch    Branch     @relation(fields: [branchId], references: [id])
  rooms     Room[]
}

model Room {
  id        String   @id @default(uuid())
  number    String
  floor     Int
  capacity  Int
  hostelId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  beds      Bed[]
  hostel    Hostel   @relation(fields: [hostelId], references: [id])

  @@unique([hostelId, number])
}

model Bed {
  id          String               @id @default(uuid())
  name        String
  status      BedStatus            @default(AVAILABLE)
  roomId      String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  room        Room                 @relation(fields: [roomId], references: [id])
  allocations HostelAllocation[]
  maintenance MaintenanceRequest[]

  @@unique([roomId, name])
}

model HostelAllocation {
  id           String    @id @default(uuid())
  checkInDate  DateTime
  checkOutDate DateTime?
  isActive     Boolean   @default(true)
  studentId    String
  bedId        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bed          Bed       @relation(fields: [bedId], references: [id])
  student      Student   @relation(fields: [studentId], references: [id])
}

model HostelLeave {
  id        String   @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  reason    String
  status    String   @default("PENDING")
  studentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id])
}

model MaintenanceRequest {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String   @default("OPEN")
  priority    String   @default("MEDIUM")
  bedId       String?
  roomId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bed         Bed?     @relation(fields: [bedId], references: [id])
}

model FeeCategory {
  id            String         @id @default(uuid())
  name          String
  description   String?
  branchId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  branch        Branch         @relation(fields: [branchId], references: [id])
  feeStructures FeeStructure[]
  invoiceItems  InvoiceItem[]
}

model FeeStructure {
  id         String      @id @default(uuid())
  amount     Float
  categoryId String
  classId    String?
  branchId   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  category   FeeCategory @relation(fields: [categoryId], references: [id])
  class      Class?      @relation(fields: [classId], references: [id])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  dueDate       DateTime
  totalAmount   Float
  balance       Float
  status        InvoiceStatus @default(UNPAID)
  studentId     String
  branchId      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  student       Student       @relation(fields: [studentId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]
}

model QuestionGroup {
  id        String       @id @default(uuid())
  name      String
  branchId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  exams     OnlineExam[]
  questions Question[]
  branch    Branch       @relation(fields: [branchId], references: [id])
}

model Question {
  id        String           @id @default(uuid())
  type      QuestionType
  content   String
  marks     Float            @default(1.0)
  groupId   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  group     QuestionGroup    @relation(fields: [groupId], references: [id])
  answers   QuestionAnswer[]
  options   QuestionOption[]
}

model QuestionOption {
  id         String   @id @default(uuid())
  content    String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model OnlineExam {
  id              String              @id @default(uuid())
  title           String
  description     String?
  scheduledDate   DateTime
  durationMinutes Int
  passPercentage  Float               @default(40.0)
  status          ExamStatus          @default(PUBLISHED)
  classId         String
  sectionId       String?
  subjectId       String
  groupId         String
  branchId        String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  branch          Branch              @relation(fields: [branchId], references: [id])
  class           Class               @relation(fields: [classId], references: [id])
  group           QuestionGroup       @relation(fields: [groupId], references: [id])
  section         Section?            @relation(fields: [sectionId], references: [id])
  subject         Subject             @relation(fields: [subjectId], references: [id])
  attempts        OnlineExamAttempt[]
}

model OnlineExamAttempt {
  id        String           @id @default(uuid())
  examId    String
  studentId String
  startTime DateTime         @default(now())
  endTime   DateTime?
  score     Float?
  position  Int?
  status    AttemptStatus    @default(IN_PROGRESS)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  exam      OnlineExam       @relation(fields: [examId], references: [id])
  student   Student          @relation(fields: [studentId], references: [id])
  answers   QuestionAnswer[]

  @@unique([examId, studentId])
}

model QuestionAnswer {
  id               String            @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  textAnswer       String?
  marksAwarded     Float?
  isCorrect        Boolean?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attempt          OnlineExamAttempt @relation(fields: [attemptId], references: [id])
  question         Question          @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model InvoiceItem {
  id         String      @id @default(uuid())
  amount     Float
  invoiceId  String
  categoryId String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  category   FeeCategory @relation(fields: [categoryId], references: [id])
  invoice    Invoice     @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id            String        @id @default(uuid())
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  proofUrl      String?
  notes         String?
  invoiceId     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
}

model Vehicle {
  id                 String                @id @default(uuid())
  registrationNumber String                @unique
  model              String
  capacity           Int
  driverName         String
  driverPhone        String?
  branchId           String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  assignments        TransportAssignment[]
  branch             Branch                @relation(fields: [branchId], references: [id])
}

model TransportRoute {
  id          String                @id @default(uuid())
  name        String
  startPoint  String
  endPoint    String
  stops       Json?
  branchId    String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  assignments TransportAssignment[]
  branch      Branch                @relation(fields: [branchId], references: [id])
}

model TransportAssignment {
  id        String         @id @default(uuid())
  studentId String         @unique
  vehicleId String
  routeId   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  route     TransportRoute @relation(fields: [routeId], references: [id])
  student   Student        @relation(fields: [studentId], references: [id])
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id])
}

model Assignment {
  id            String       @id @default(uuid())
  title         String
  description   String?
  dueDate       DateTime
  attachmentUrl String?
  subjectId     String
  sectionId     String
  teacherId     String?
  branchId      String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  branch        Branch       @relation(fields: [branchId], references: [id])
  section       Section      @relation(fields: [sectionId], references: [id])
  subject       Subject      @relation(fields: [subjectId], references: [id])
  teacher       Staff?       @relation(fields: [teacherId], references: [id])
  submissions   Submission[]
}

model Submission {
  id           String     @id @default(uuid())
  contentUrl   String?
  grade        Float?
  feedback     String?
  status       String     @default("SUBMITTED")
  assignmentId String
  studentId    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
}

model AcademicSession {
  id                 String              @id @default(uuid())
  name               String
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean             @default(true)
  nextTermBegins     DateTime?
  termEnds           DateTime?
  branchId           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  branch             Branch              @relation(fields: [branchId], references: [id])
  assessmentRecords  AssessmentRecord[]
  behaviouralRatings BehaviouralRating[]
  digitalResources   DigitalResource[]
  idCards            IdCard[]
  onlineAdmissions   OnlineAdmission[]
  resultSummaries    ResultSummary[]

  @@index([branchId])
}

model AssessmentRecord {
  id         String          @id @default(uuid())
  asgn1      Float?          @default(0)
  asgn2      Float?          @default(0)
  test1      Float?          @default(0)
  test2      Float?          @default(0)
  examScore  Float?          @default(0)
  total      Float?          @default(0)
  grade      String?
  position   Int?
  outOf      Int?
  lowScore   Float?
  highScore  Float?
  classAvg   Float?
  remark     String?
  studentId  String
  subjectId  String
  sectionId  String
  sessionId  String
  branchId   String
  term       Term
  examTerm   ExamTerm
  isEligible Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  branch     Branch          @relation(fields: [branchId], references: [id])
  section    Section         @relation(fields: [sectionId], references: [id])
  session    AcademicSession @relation(fields: [sessionId], references: [id])
  student    Student         @relation(fields: [studentId], references: [id])
  subject    Subject         @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId, sessionId, term])
  @@index([branchId])
}

model BehaviouralRating {
  id                     String          @id @default(uuid())
  punctuality            String?
  classAttendance        String?
  attentiveness          String?
  neatness               String?
  honesty                String?
  selfControl            String?
  relationships          String?
  sports                 String?
  toolHandling           String?
  carryingOutAssignments String?
  participation          String?
  studentId              String
  sessionId              String
  branchId               String
  term                   Term
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  branch                 Branch          @relation(fields: [branchId], references: [id])
  session                AcademicSession @relation(fields: [sessionId], references: [id])
  student                Student         @relation(fields: [studentId], references: [id])

  @@unique([studentId, sessionId, term])
  @@index([branchId])
}

model ResultSummary {
  id                String          @id @default(uuid())
  totalScore        Float?
  average           Float?
  classPosition     Int?
  highestAvg        Float?
  lowestAvg         Float?
  countInClass      Int?
  finalGrade        String?
  finalRemark       String?
  promotionStatus   String?
  cgpa              Float?
  classOfResult     String?
  attendanceOpen    Int?
  attendancePresent Int?
  attendanceAbsent  Int?
  studentId         String
  sessionId         String
  branchId          String
  term              Term
  examTerm          ExamTerm
  isActive          Boolean         @default(true)
  isLocked          Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  branch            Branch          @relation(fields: [branchId], references: [id])
  session           AcademicSession @relation(fields: [sessionId], references: [id])
  student           Student         @relation(fields: [studentId], references: [id])

  @@unique([studentId, sessionId, term])
  @@index([branchId])
}

model GradingScale {
  id        String   @id @default(uuid())
  name      String
  minScore  Float
  maxScore  Float
  grade     String
  remark    String?
  branchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model GlobalSetting {
  id        String   @id @default(uuid())
  key       String
  value     String
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@unique([key, branchId])
  @@index([branchId])
}

model RolePermission {
  id        String   @id @default(uuid())
  role      UserRole
  module    String
  action    String
  isAllowed Boolean  @default(false)

  @@unique([role, module, action])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  module    String
  details   String?
  reason    String?
