// ═══════════════════════════════════════════════════════════════════════
// Accounting — General Ledger, Chart of Accounts, Double-Entry
// ═══════════════════════════════════════════════════════════════════════

enum AccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

enum EntrySide {
  DEBIT
  CREDIT
}

enum JournalType {
  INVOICE
  PAYMENT
  VOUCHER
  CREDIT_NOTE
  REFUND
  JOURNAL
}

model ChartOfAccount {
  id          String               @id @default(uuid())
  code        String               @unique
  name        String
  type        AccountType
  parentId    String?
  branchId    String
  sessionId   String?
  isActive    Boolean              @default(true)
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  parent      ChartOfAccount?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    ChartOfAccount[]     @relation("AccountHierarchy")
  branch      Branch               @relation(fields: [branchId], references: [id])
  session     AcademicSession?     @relation(fields: [sessionId], references: [id])
  entries     GeneralLedgerEntry[]

  @@index([branchId])
  @@index([sessionId])
  @@index([type])
  @@index([code])
  @@index([deletedAt])
}

model JournalEntry {
  id          String               @id @default(uuid())
  journalType JournalType
  referenceId String
  description String?
  date        DateTime             @default(now())
  branchId    String
  sessionId   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  branch      Branch               @relation(fields: [branchId], references: [id])
  session     AcademicSession?     @relation(fields: [sessionId], references: [id])
  lines       GeneralLedgerEntry[]

  @@index([branchId])
  @@index([sessionId])
  @@index([journalType, referenceId])
  @@index([date])
  @@index([deletedAt])
}

model GeneralLedgerEntry {
  id          String           @id @default(uuid())
  journalId   String
  accountId   String
  side        EntrySide
  amount      Decimal          @db.Decimal(12, 2)
  description String?
  branchId    String
  sessionId   String?
  createdAt   DateTime         @default(now())
  journal     JournalEntry     @relation(fields: [journalId], references: [id])
  account     ChartOfAccount   @relation(fields: [accountId], references: [id])
  branch      Branch           @relation(fields: [branchId], references: [id])
  session     AcademicSession? @relation(fields: [sessionId], references: [id])

  @@index([journalId])
  @@index([accountId])
  @@index([branchId])
  @@index([sessionId])
}

model TaxRate {
  id        String           @id @default(uuid())
  name      String
  rate      Decimal          @db.Decimal(5, 2)
  type      String // VAT, WHT, SERVICE_CHARGE
  branchId  String
  sessionId String?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  branch    Branch           @relation(fields: [branchId], references: [id])
  session   AcademicSession? @relation(fields: [sessionId], references: [id])

  @@index([branchId])
  @@index([sessionId])
  @@index([deletedAt])
}

model BankStatementLine {
  id               String           @id @default(uuid())
  transactionRef   String?
  date             DateTime
  description      String
  amount           Decimal          @db.Decimal(12, 2)
  type             String // CREDIT, DEBIT
  matchedPaymentId String?
  branchId         String
  sessionId        String?
  isReconciled     Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  matchedPayment   Payment?         @relation(fields: [matchedPaymentId], references: [id])
  branch           Branch           @relation(fields: [branchId], references: [id])
  session          AcademicSession? @relation(fields: [sessionId], references: [id])

  @@index([branchId])
  @@index([sessionId])
  @@index([date])
  @@index([matchedPaymentId])
  @@index([isReconciled])
  @@index([deletedAt])
}
