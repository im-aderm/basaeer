generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id                            String                        @id @default(uuid())
  name                          String
  code                          String                        @unique
  address                       String?
  phone                         String?
  email                         String?
  logoUrl                       String?
  primaryColor                  String?                       @default("#2563EB")
  emailFooter                   String?
  smsSenderId                   String?
  isActive                      Boolean                       @default(true)
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  enquiries                     AdmissionEnquiry[]
  alumni                        Alumni[]
  alumniEvents                  AlumniEvent[]
  assignments                   Assignment[]
  automationConfigs             AutomationConfig[]
  books                         Book[]
  callLogs                      CallLog[]
  accessLogs                    CampusAccessLog[]
  campusEvents                  CampusEvent[]
  certificates                  Certificate[]
  certificateTemplates          CertificateTemplate[]
  classes                       Class[]
  complaints                    Complaint[]
  conversations                 Conversation[]
  deactivationReasons           DeactivationReason[]
  attachmentCategories          AttachmentCategory[]
  departments                   Department[]
  designations                  Designation[]
  digitalResources              DigitalResource[]
  expenseCategories             ExpenseCategory[]
  feeCategories                 FeeCategory[]
  googleMeetConfig              GoogleMeetConfig?
  hostels                       Hostel[]
  idCardTemplates               IdCardTemplate[]
  inventoryCategories           InventoryCategory[]
  inventoryIssues               InventoryIssue[]
  inventoryProducts             InventoryProduct[]
  inventoryPurchases            InventoryPurchase[]
  inventorySales                InventorySale[]
  inventoryStores               InventoryStore[]
  inventorySuppliers            InventorySupplier[]
  inventoryUnits                InventoryUnit[]
  liveClassSessions             LiveClassSession[]
  loginDeactivations            LoginDeactivation[]
  onlineAdmissions              OnlineAdmission[]
  onlineExams                   OnlineExam[]
  postalRecords                 PostalRecord[]
  studentAccounts               StudentAccount[]
  questionGroups                QuestionGroup[]
  students                      Student[]
  studentCategories             StudentCategory[]
  subjects                      Subject[]
  routes                        TransportRoute[]
  users                         User[]
  vehicles                      Vehicle[]
  visitorLogs                   VisitorLog[]
  vouchers                      Voucher[]
  academicSessions              AcademicSession[]
  attendance                    Attendance[]
  staffAttendance               StaffAttendance[]
  attendanceSessions            AttendanceSession[]
  attendanceScans               AttendanceScan[]
  assessmentRecords             AssessmentRecord[]
  behaviouralRatings            BehaviouralRating[]
  resultSummaries               ResultSummary[]
  gradingScales                 GradingScale[]
  globalSettings                GlobalSetting[]
  moduleConfigurations          ModuleConfiguration[]
  scheduledJobs                 ScheduledJob[]
  emailTemplates                EmailTemplate[]
  smsTemplates                  SmsTemplate[]
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  campaigns                     Campaign[]
  campaignRecipients            CampaignRecipient[]
  queueJobLogs                  QueueJobLog[]
  automationExecutions          AutomationExecution[]
  messageDeliveryLogs           MessageDeliveryLog[]
  providerHealthLogs            ProviderHealthLog[]
  webhookEvents                 WebhookEvent[]
  deliveryWebhookLogs           DeliveryWebhookLog[]
  realtimeConnections           RealtimeConnection[]
  queueMetrics                  QueueMetric[]
  providerFailoverEvents        ProviderFailoverEvent[]
  messageRetryEvents            MessageRetryEvent[]
  providerBalanceSnapshots      ProviderBalanceSnapshot[]
  creditTransactions            CreditTransaction[]
  counters                      Counter[]
  notificationDeliveryEvents    NotificationDeliveryEvent[]
  academicExports               AcademicExport[]
  reportTemplates               ReportTemplate[]
  computationJobs               ComputationJob[]
  apiKeys                       ApiKey[]
  webhookEndpoints              WebhookEndpoint[]
  exams                         Exam[]
  examTypes                     ExamType[]
  assessmentComponents          AssessmentComponent[]
  resultApprovals               ResultApproval[]
  resultPublications            ResultPublication[]
  gpaRecords                    GPARecord[]
  studentRankings               StudentRanking[]
  broadsheets                   Broadsheet[]
  transcripts                   Transcript[]
  academicRemarks               AcademicRemark[]
  subjectPositions              SubjectPosition[]
  tahfeezAssessments            TahfeezAssessment[]
  tahfeezMemorizationProgresses TahfeezMemorizationProgress[]
  invoices                      Invoice[]
  payments                      Payment[]
  borrowRecords                 BorrowRecord[]
  libraryFines                  LibraryFine[]
  salaryTemplates               SalaryTemplate[]
  payrolls                      Payroll[]
  leaveRequests                 LeaveRequest[]
  staffAwards                   StaffAward[]
  advanceSalaries               AdvanceSalary[]
  hostelAllocations             HostelAllocation[]
  hostelLeaves                  HostelLeave[]
  maintenanceRequests           MaintenanceRequest[]
  submissions                   Submission[]
  classSchedules                ClassSchedule[]
  idCards                       IdCard[]
  bookCopies                    BookCopy[]
  bookReservations              BookReservation[]
  hostelMaintenanceTickets      HostelMaintenanceTicket[]
  roles                         Role[]
  admissionInterviews           AdmissionInterview[]
  admissionExams                AdmissionExam[]
  transportAssignments          TransportAssignment[]
  chartOfAccounts               ChartOfAccount[]
  journalEntries                JournalEntry[]
  generalLedgerEntries          GeneralLedgerEntry[]
  taxRates                      TaxRate[]
  bankStatementLines            BankStatementLine[]
}

model DeactivationReason {
  id            String              @id @default(uuid())
  title         String
  description   String?
  branchId      String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  branch        Branch              @relation(fields: [branchId], references: [id])
  deactivations LoginDeactivation[]

  @@index([branchId])
}

model LoginDeactivation {
  id            String              @id @default(uuid())
  studentId     String
  userId        String
  reason        String
  reasonId      String?
  branchId      String
  deactivatedBy String?
  reactivatedAt DateTime?
  reactivatedBy String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  branch        Branch              @relation(fields: [branchId], references: [id])
  reasonRef     DeactivationReason? @relation(fields: [reasonId], references: [id])
  student       Student             @relation(fields: [studentId], references: [id])

  @@index([branchId])
  @@index([userId])
  @@index([studentId])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  branchId    String?
  isSystem    Boolean  @default(false)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch      Branch?                @relation(fields: [branchId], references: [id])
  users       User[]
  permissions CustomRolePermission[]
}

model User {
  id                         String                    @id @default(uuid())
  email                      String                    @unique
  password                   String
  firstName                  String
  lastName                   String
  phone                      String?
  isActive                   Boolean                   @default(true)
  mustChangePassword         Boolean                   @default(false)
  role                       UserRole
  roleId                     String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  branchId                   String?
  resetTokenHash             String?
  resetTokenExpires          DateTime?
  auditLogs                  AuditLog[]
  accessLogs                 CampusAccessLog[]
  realtimeConnections        RealtimeConnection[]
  issuedCertificates         Certificate[]             @relation("IssuedCertificates")
  conversationParticipations ConversationParticipant[]
  digitalResourceLogs        DigitalResourceLog[]
  eventRSVPs                 EventRSVP[]
  meetingParticipations      MeetingParticipant[]
  sentMessages               Message[]
  onlineAdmissions           OnlineAdmission[]         @relation("ParentAdmission")
  staff                      Staff?
  children                   Student[]                 @relation("ParentToStudent")
  student                    Student?
  branch                     Branch?                   @relation(fields: [branchId], references: [id])
  customRole                 Role?                     @relation(fields: [roleId], references: [id])
  approvedVouchers           Voucher[]                 @relation("VoucherApprover")
  preferences                UserPreference?
  notifications              Notification[]
  notificationPreference     NotificationPreference?
  campaignRecipients         CampaignRecipient[]
  academicExports            AcademicExport[]
  computationJobs            ComputationJob[]
  createdExams               Exam[]                    @relation("ExamCreator")

  @@index([branchId])
  @@index([role, isActive])
  @@index([email, isActive])
}

model UserPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  theme            String   @default("light")
  language         String   @default("en")
  sidebarCollapsed Boolean  @default(false)
  dashboardWidgets Json?
  notifications    Json?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt        DateTime @updatedAt
}

model ModuleConfiguration {
  id        String   @id @default(uuid())
  moduleKey String
  isEnabled Boolean  @default(true)
  config    Json?
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@unique([moduleKey, branchId])
  @@index([branchId])
}

model Translation {
  id        String   @id @default(uuid())
  locale    String
  group     String   @default("general")
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, group, key])
  @@index([locale, group])
}

model ScheduledJob {
  id         String    @id @default(uuid())
  name       String    @unique
  cron       String
  lastRun    DateTime?
  nextRun    DateTime?
  status     String    @default("IDLE")
  lastResult String?
  errorCount Int       @default(0)
  isEnabled  Boolean   @default(true)
  branchId   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  branch     Branch?   @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model Staff {
  id                 String              @id @default(uuid())
  userId             String              @unique
  designation        String?
  departmentId       String?
  designationId      String?
  status             StaffStatus         @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  salaryAdvances     AdvanceSalary[]
  assignments        Assignment[]
  classes            Class[]
  classSchedules     ClassSchedule[]
  digitalResources   DigitalResource[]
  idCards            IdCard[]
  inventoryIssues    InventoryIssue[]
  leaveRequests      LeaveRequest[]
  hostedSessions     LiveClassSession[]
  payrolls           Payroll[]
  salaryTemplate     SalaryTemplate?
  department         Department?         @relation(fields: [departmentId], references: [id])
  designationRef     Designation?        @relation(fields: [designationId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  deletedAt          DateTime?
  createdByUserId    String?
  updatedByUserId    String?
  attendance         StaffAttendance[]
  awards             StaffAward[]
  subjects           Subject[]           @relation("StaffToSubject")
  attendanceSessions AttendanceSession[]
}

model Student {
  id                        String                @id @default(uuid())
  userId                    String?               @unique
  admissionNumber           String?               @unique
  firstName                 String
  lastName                  String
  gender                    String?
  dob                       DateTime?
  branchId                  String
  classId                   String?
  sectionId                 String?
  parentId                  String?
  categoryId                String?
  enrollmentStatus          String                @default("ACTIVE")
  admissionDate             DateTime?
  exitDate                  DateTime?
  exitReason                String?
  otherNames                String?
  placeOfBirth              String?
  nationality               String?
  stateOfOrigin             String?
  lga                       String?
  religion                  String?
  passportPhoto             String?
  guardianOccupation        String?
  guardianOfficeAddress     String?
  secondaryGuardianName     String?
  secondaryGuardianPhone    String?
  secondaryGuardianRelation String?
  city                      String?
  state                     String?
  country                   String?
  emergencyContactName      String?
  emergencyContactPhone     String?
  emergencyContactRelation  String?
  bloodGroup                String?
  genotype                  String?
  allergies                 String?
  medicalConditions         String?
  specialNeeds              String?
  familyDoctorName          String?
  familyDoctorPhone         String?
  birthCertificateUrl       String?
  testimonialUrl            String?
  transferCertificateUrl    String?
  immunizationCardUrl       String?
  preferredLanguage         String?
  religionClassType         String?
  scholarshipEligible       Boolean               @default(false)
  referralSource            String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  deletedAt                 DateTime?
  createdByUserId           String?
  updatedByUserId           String?
  alumni                    Alumni?
  assessmentRecords         AssessmentRecord[]
  attendance                Attendance[]
  behaviouralRatings        BehaviouralRating[]
  borrowRecords             BorrowRecord[]
  certificates              Certificate[]
  hostelAllocations         HostelAllocation[]
  hostelLeaves              HostelLeave[]
  idCards                   IdCard[]
  inventoryIssues           InventoryIssue[]
  invoices                  Invoice[]
  onlineExamAttempts        OnlineExamAttempt[]
  resultSummaries           ResultSummary[]
  branch                    Branch                @relation(fields: [branchId], references: [id])
  category                  StudentCategory?      @relation(fields: [categoryId], references: [id])
  class                     Class?                @relation(fields: [classId], references: [id])
  parent                    User?                 @relation("ParentToStudent", fields: [parentId], references: [id])
  section                   Section?              @relation(fields: [sectionId], references: [id])
  user                      User?                 @relation(fields: [userId], references: [id])
  submissions               Submission[]
  transportAssignment       TransportAssignment?
  attendanceScans           AttendanceScan[]
  bookReservations          BookReservation[]
  transportAttendances      TransportAttendance[]
  assessmentScores          AssessmentScore[]
  studentAccount            StudentAccount?
  vouchers                  Voucher[]
  loginDeactivations        LoginDeactivation[]

  @@index([branchId])
  @@index([branchId, classId, sectionId])
  @@index([classId, sectionId])
  @@index([parentId])
  @@index([branchId, classId])
  @@index([enrollmentStatus])
  @@index([admissionNumber])
}

model Certificate {
  id                String               @id @default(uuid())
  type              String
  certificateNumber String               @unique
  issueDate         DateTime             @default(now())
  content           Json?
  verificationCode  String               @unique @default(cuid())
  isVerified        Boolean              @default(true)
  studentId         String
  templateId        String?
  issuedByUserId    String
  branchId          String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  branch            Branch               @relation(fields: [branchId], references: [id])
  issuedBy          User                 @relation("IssuedCertificates", fields: [issuedByUserId], references: [id])
  student           Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template          CertificateTemplate? @relation(fields: [templateId], references: [id])

  @@index([branchId])
}

model CertificateTemplate {
  id              String        @id @default(uuid())
  name            String
  type            String
  backgroundImage String?
  config          Json
  branchId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  certificates    Certificate[]
  branch          Branch        @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model Class {
  id                 String              @id @default(uuid())
  name               String
  gradeLevel         Int?
  branchId           String
  classTeacherId     String?
  capacity           Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  createdByUserId    String?
  updatedByUserId    String?
  branch             Branch              @relation(fields: [branchId], references: [id])
  classTeacher       Staff?              @relation(fields: [classTeacherId], references: [id])
  classSchedules     ClassSchedule[]
  digitalResources   DigitalResource[]
  feeStructures      FeeStructure[]
  liveClassSessions  LiveClassSession[]
  onlineAdmissions   OnlineAdmission[]
  onlineExams        OnlineExam[]
  sections           Section[]
  students           Student[]
  attendanceSessions AttendanceSession[]
  offeredAdmissions  OnlineAdmission[]   @relation("OfferedClassAdmission")
  exams              Exam[]

  @@unique([branchId, name])
  @@index([branchId])
}

model Section {
  id                 String              @id @default(uuid())
  name               String
  classId            String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  createdByUserId    String?
  updatedByUserId    String?
  assessmentRecords  AssessmentRecord[]
  assignments        Assignment[]
  attendance         Attendance[]
  classSchedules     ClassSchedule[]
  digitalResources   DigitalResource[]
  liveClassSessions  LiveClassSession[]
  onlineAdmissions   OnlineAdmission[]
  onlineExams        OnlineExam[]
  class              Class               @relation(fields: [classId], references: [id])
  students           Student[]
  attendanceSessions AttendanceSession[]
  offeredAdmissions  OnlineAdmission[]   @relation("OfferedSectionAdmission")
  exams              Exam[]

  @@unique([classId, name])
  @@index([classId])
}

model Subject {
  id                 String              @id @default(uuid())
  name               String
  code               String?
  branchId           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  createdByUserId    String?
  updatedByUserId    String?
  assessmentRecords  AssessmentRecord[]
  assignments        Assignment[]
  classSchedules     ClassSchedule[]
  digitalResources   DigitalResource[]
  liveClassSessions  LiveClassSession[]
  onlineExams        OnlineExam[]
  branch             Branch              @relation(fields: [branchId], references: [id])
  teachers           Staff[]             @relation("StaffToSubject")
  attendanceSessions AttendanceSession[]

  @@index([branchId])
}

model ClassSchedule {
  id        String   @id @default(uuid())
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?
  classId   String
  sectionId String
  subjectId String
  teacherId String
  branchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id])
  section   Section  @relation(fields: [sectionId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacher   Staff    @relation(fields: [teacherId], references: [id])
  branch    Branch   @relation(fields: [branchId], references: [id])

  @@unique([teacherId, dayOfWeek, startTime])
  @@unique([classId, sectionId, dayOfWeek, startTime])
  @@index([classId, sectionId])
  @@index([branchId])
}

model Attendance {
  id        String             @id @default(uuid())
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  studentId String
  sectionId String?
  sessionId String?
  branchId  String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  branch    Branch             @relation(fields: [branchId], references: [id])
  section   Section?           @relation(fields: [sectionId], references: [id])
  student   Student            @relation(fields: [studentId], references: [id])
  session   AttendanceSession? @relation(fields: [sessionId], references: [id])

  @@unique([studentId, date, sessionId])
  @@index([branchId])
  @@index([branchId, sectionId, date])
  @@index([sectionId, date])
  @@index([sessionId])
  @@index([studentId, date])
  @@index([branchId, date])
  @@index([branchId, date, studentId])
}

model StaffAttendance {
  id        String           @id @default(uuid())
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  staffId   String
  branchId  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  branch    Branch           @relation(fields: [branchId], references: [id])
  staff     Staff            @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@index([branchId])
  @@index([branchId, date])
  @@index([staffId, date])
}

model Hostel {
  id                       String                    @id @default(uuid())
  name                     String
  type                     HostelType
  address                  String?
  branchId                 String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  branch                   Branch                    @relation(fields: [branchId], references: [id])
  rooms                    Room[]
  hostelMaintenanceTickets HostelMaintenanceTicket[]

  @@index([branchId])
}

model Room {
  id        String   @id @default(uuid())
  number    String
  floor     Int
  capacity  Int
  hostelId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  beds      Bed[]
  hostel    Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@unique([hostelId, number])
}

model Bed {
  id          String               @id @default(uuid())
  name        String
  status      BedStatus            @default(AVAILABLE)
  roomId      String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  room        Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocations HostelAllocation[]
  maintenance MaintenanceRequest[]

  @@unique([roomId, name])
}

model HostelAllocation {
  id           String    @id @default(uuid())
  checkInDate  DateTime
  checkOutDate DateTime?
  isActive     Boolean   @default(true)
  studentId    String
  bedId        String
  branchId     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bed          Bed       @relation(fields: [bedId], references: [id], onDelete: Cascade)
  student      Student   @relation(fields: [studentId], references: [id])
  branch       Branch    @relation(fields: [branchId], references: [id])

  @@unique([studentId, isActive])
  @@index([studentId])
  @@index([bedId])
  @@index([branchId])
}

model HostelLeave {
  id        String            @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  reason    String
  status    HostelLeaveStatus @default(PENDING)
  studentId String
  branchId  String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  student   Student           @relation(fields: [studentId], references: [id])
  branch    Branch            @relation(fields: [branchId], references: [id])

  @@index([studentId])
  @@index([branchId])
}

model MaintenanceRequest {
  id          String              @id @default(uuid())
  title       String
  description String
  status      MaintenanceStatus   @default(OPEN)
  priority    MaintenancePriority @default(MEDIUM)
  bedId       String?
  roomId      String?
  branchId    String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  bed         Bed?                @relation(fields: [bedId], references: [id])
  branch      Branch              @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model FeeCategory {
  id            String         @id @default(uuid())
  name          String
  description   String?
  branchId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  branch        Branch         @relation(fields: [branchId], references: [id])
  feeStructures FeeStructure[]
  invoiceItems  InvoiceItem[]

  @@index([branchId])
}

model FeeStructure {
  id         String      @id @default(uuid())
  amount     Decimal     @db.Decimal(12, 2)
  categoryId String
  classId    String?
  branchId   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  category   FeeCategory @relation(fields: [categoryId], references: [id])
  class      Class?      @relation(fields: [classId], references: [id])

  @@index([branchId])
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  dueDate         DateTime
  totalAmount     Decimal       @db.Decimal(12, 2)
  balance         Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(UNPAID)
  studentId       String
  branchId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdByUserId String?
  updatedByUserId String?
  student         Student       @relation(fields: [studentId], references: [id])
  branch          Branch        @relation(fields: [branchId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]

  @@index([branchId])
  @@index([studentId])
  @@index([branchId, status])
  @@index([branchId, dueDate])
}

model QuestionGroup {
  id        String       @id @default(uuid())
  name      String
  branchId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  exams     OnlineExam[]
  questions Question[]
  branch    Branch       @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model Question {
  id        String           @id @default(uuid())
  type      QuestionType
  content   String
  marks     Decimal          @default(1.0) @db.Decimal(5, 2)
  groupId   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  group     QuestionGroup    @relation(fields: [groupId], references: [id])
  answers   QuestionAnswer[]
  options   QuestionOption[]

  @@index([groupId])
}

model QuestionOption {
  id         String   @id @default(uuid())
  content    String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model OnlineExam {
  id              String              @id @default(uuid())
  title           String
  description     String?
  scheduledDate   DateTime
  durationMinutes Int
  passPercentage  Decimal             @default(40.0) @db.Decimal(5, 2)
  status          ExamStatus          @default(PUBLISHED)
  classId         String
  sectionId       String?
  subjectId       String
  groupId         String
  branchId        String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  branch          Branch              @relation(fields: [branchId], references: [id])
