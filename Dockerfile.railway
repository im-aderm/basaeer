# Build Stage
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies for native modules
RUN apk add --no-cache python3 make g++ openssl libc6-compat

# Copy root package files
COPY package.json package-lock.json ./
# Copy all package.json files first to leverage Docker cache
COPY backend/package.json ./backend/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY frontend/package.json ./frontend/

# Install all dependencies (including devDependencies for building)
# Use --ignore-scripts to prevent postinstall scripts (like prisma generate) from failing
# because the source code (schema.prisma) isn't copied yet.
RUN npm ci --ignore-scripts

# Copy the rest of the application source
COPY . .

# Build the shared packages first
RUN npm run build --workspace=@basaeer/shared-types || true

# Generate Prisma Client (uses the prisma binary installed in node_modules)
RUN cd backend && npx prisma generate

# Build the backend application
RUN npm run build --workspace=backend

# Prune devDependencies to keep the production image small
# We do this here so we can copy the clean node_modules to the runner
RUN npm prune --omit=dev --ignore-scripts

# Production Stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
# Ensure node_modules/.bin is in the PATH so 'prisma' and 'npx prisma' work reliably
ENV PATH /app/node_modules/.bin:$PATH

# Install runtime dependencies for Prisma and Node
RUN apk add --no-cache openssl libc6-compat

# Create non-root user for security
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copy pruned node_modules from builder (crucial to avoid re-installing in production)
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# Copy built assets and necessary files
COPY --from=builder /app/packages/shared-types ./packages/shared-types
COPY --from=builder /app/backend/package.json ./backend/package.json
COPY --from=builder /app/backend/dist ./backend/dist
COPY --from=builder /app/backend/prisma ./backend/prisma
COPY --from=builder /app/backend/prisma.config.ts ./backend/prisma.config.ts

# Ensure the generated Prisma client is available for both the source and the build
COPY --from=builder /app/backend/src/generated ./backend/src/generated
COPY --from=builder /app/backend/src/generated ./backend/dist/generated

# Copy the start script
COPY --from=builder /app/backend/scripts/start.sh ./backend/scripts/start.sh

# Fix permissions for the start script and the app directory
RUN chmod +x ./backend/scripts/start.sh && \
    chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/health || exit 1

# Use the start script to handle migrations and app startup
# This is the most reliable way to ensure migrations run before the app starts
CMD ["sh", "./backend/scripts/start.sh"]
