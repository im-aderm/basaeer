# Build Stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root package files
COPY package.json package-lock.json ./
# Copy workspace packages
COPY backend/package.json ./backend/
COPY packages/shared-types/package.json ./packages/shared-types/

# Install all dependencies using workspaces (ignore postinstall scripts since they are run explicitly later)
RUN npm ci --ignore-scripts

# Copy the rest of the application
COPY backend/ ./backend/
COPY packages/ ./packages/

# Generate Prisma Client
RUN cd backend && npx prisma generate

# Build the backend application and shared types if needed
RUN cd packages/shared-types && npm run build || true
RUN cd backend && npm run build

# Production Stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Install system dependencies for Prisma
RUN apk add --no-cache openssl libc6-compat

# Create non-root user for security
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copy necessary files for production installation
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY packages/shared-types/package.json ./packages/shared-types/

# Install only production dependencies (ignore postinstall scripts since assets are copied from builder)
RUN npm ci --omit=dev --ignore-scripts


# Copy built assets
COPY --from=builder /app/packages/shared-types ./packages/shared-types
COPY --from=builder /app/backend/dist ./backend/dist
COPY --from=builder /app/backend/prisma ./backend/prisma
COPY --from=builder /app/backend/prisma.config.ts ./backend/prisma.config.ts
COPY --from=builder /app/backend/src/generated ./backend/dist/generated

# Set proper ownership
RUN chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/health || exit 1

# Start the application
CMD ["node", "backend/dist/main.js"]
