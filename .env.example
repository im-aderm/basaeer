# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env)
# ==============================================================================

# ── General Application Settings ──────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://basaeer.yourdomain.com
API_URL=https://api.basaeer.yourdomain.com

# ── Database (Local PostgreSQL) ─────────────────────────────────────────
POSTGRES_USER=basaeer
POSTGRES_PASSWORD=strong_postgres_password_here
POSTGRES_DB=basaeer
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ── Redis (Local Redis) ─────────────────────────────────────────────────────
# Used for BullMQ, Rate Limiting, and Socket.io adapter
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=strong_redis_password_here

# ── JWT & Authentication ──────────────────────────────────────────────────────
# Generate a strong, secure string (e.g., using `openssl rand -hex 64`)
JWT_SECRET=super_secret_jwt_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_key
JWT_REFRESH_EXPIRES_IN=30d

# Security / Encryption
ENCRYPTION_SECRET=your-strong-encryption-secret-here
ENCRYPTION_SALT=your-encryption-salt-here

BOOTSTRAP_SECRET=your-extremely-secret-bootstrap-token-here

# ── File Storage Configuration ───────────────────────────────────────────
# Self-hosted upload directory mounted via Docker volume
UPLOAD_DIR=/app/public/uploads
MAX_FILE_SIZE_MB=5

# ── SMTP / Email Configuration (Optional for notifications) ───────────────────
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=no-reply@basaeer.com

# ── Security & CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://basaeer.yourdomain.com

# ── Admin & Seeding ───────────────────────────────────────────────────────────
# Default super admin credentials for initial setup
DEFAULT_ADMIN_EMAIL=admin@basaeer.com
DEFAULT_ADMIN_PASSWORD=SecureAdminPassword123!
