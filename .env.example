# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env)
# ==============================================================================

# ── General Application Settings ──────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://basaeer-frontend.vercel.app
API_URL=https://your-api-subdomain.up.railway.app

# ── Database (PostgreSQL via Railway) ─────────────────────────────────────────
# Connection string provided by Railway. Ensure connection pooling is used if needed.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=20&pool_timeout=10
DATABASE_URL=postgresql://postgres:password@host:port/database

# ── Redis (Railway Redis) ─────────────────────────────────────────────────────
# Used for BullMQ, Rate Limiting, and Socket.io adapter
REDIS_URL=redis://default:password@host:port
REDIS_HOST=host
REDIS_PORT=port
REDIS_PASSWORD=password

# ── JWT & Authentication ──────────────────────────────────────────────────────
# Generate a strong, secure string (e.g., using `openssl rand -hex 64`)
JWT_SECRET=super_secret_jwt_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_key
JWT_REFRESH_EXPIRES_IN=30d

# ── Cloudflare R2 (Object Storage) ────────────────────────────────────────────
# R2 connection details for uploads (images, PDFs, documents)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=basaeer-production
# Public URL for the bucket (must be configured in Cloudflare Dashboard)
R2_PUBLIC_DOMAIN=https://cdn.basaeer.com

# ── Upload Validation configuration ───────────────────────────────────────────
MAX_FILE_SIZE_MB=5

# ── SMTP / Email Configuration (Optional for notifications) ───────────────────
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=no-reply@basaeer.com

# ── Security & CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://basaeer-frontend.vercel.app,https://your-custom-domain.com

# ── Admin & Seeding ───────────────────────────────────────────────────────────
# Default super admin credentials for initial setup
DEFAULT_ADMIN_EMAIL=admin@basaeer.com
DEFAULT_ADMIN_PASSWORD=SecureAdminPassword123!
