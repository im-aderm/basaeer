# ==============================================================================
# BASAEER — VPS PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# All infrastructure is local: PostgreSQL + Redis on the same VPS.
# No cloud-managed services assumed.
# ==============================================================================

# ── General Application Settings ──────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://basaeer.yourdomain.com
API_URL=https://api.basaeer.yourdomain.com

# ── Database (Local PostgreSQL) ─────────────────────────────────────────
POSTGRES_USER=basaeer
POSTGRES_PASSWORD=strong_postgres_password_here
POSTGRES_DB=basaeer
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ── Redis (Local Redis) ─────────────────────────────────────────────────────
# Used for BullMQ, Rate Limiting, and Socket.io adapter
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=strong_redis_password_here

# ── JWT & Authentication ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-to-another-random-hex-string
JWT_REFRESH_EXPIRES_IN=30d

# Security / Encryption
ENCRYPTION_SECRET=your-strong-encryption-secret-here
ENCRYPTION_SALT=your-encryption-salt-here

# ── Bootstrap Security ────────────────────────────────────────────────────────
BOOTSTRAP_SECRET=your-extremely-secret-bootstrap-token-here

# ── Seed Passwords ────────────────────────────────────────────────────────────
SEED_DEFAULT_PASSWORD=ChangeMeDefault123!
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SUPER_ADMIN_EMAIL=superadmin@basaeer.local

# ── SMTP / Email ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-login@brevo.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@basaeer.edu

# ── SMS (Termii) ──────────────────────────────────────────────────────────────
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=Basaeer

# ── Security & CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://basaeer.yourdomain.com

# ── File Upload Storage ───────────────────────────────────────────────────────
# Local filesystem upload directory (served via /public/uploads)
UPLOAD_DIR=/app/public/uploads
MAX_FILE_SIZE_MB=5
