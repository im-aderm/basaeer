# ==============================================================================
# BASAEER — ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to ".env" and fill in your values.
#
# DATABASE HOSTNAME:
#   Docker  → postgres (uses Docker's internal DNS)
#   Bare VM → localhost (or your server IP)
# ==============================================================================


# ─── REQUIRED — App won't start without these ─────────────────────────────────

NODE_ENV=production                # production | development | staging
PORT=3001                          # Backend server port


# ─── PostgreSQL Database ──────────────────────────────────────────────────────
# Docker:     DATABASE_URL=postgresql://basaeer:YOUR_PASS@postgres:5432/basaeer
# Bare VM:    DATABASE_URL=postgresql://basaeer:YOUR_PASS@localhost:5432/basaeer

DATABASE_URL=postgresql://basaeer:CHANGE_ME@localhost:5432/basaeer?schema=public
DB_POOL_SIZE=20


# ─── JWT & Authentication ─────────────────────────────────────────────────────

JWT_SECRET=CHANGE_ME_64_CHAR_HEX                   # Generate: openssl rand -hex 64
JWT_EXPIRES_IN=7d                                   # 60m | 24h | 7d
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_HEX            # Generate: openssl rand -hex 64
JWT_REFRESH_EXPIRES_IN=30d


# ─── Bootstrap (initial SuperAdmin creation) ──────────────────────────────────

BOOTSTRAP_SECRET=CHANGE_ME_32_CHAR_HEX              # Generate: openssl rand -hex 32
SUPER_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_DEFAULT_PASSWORD=ChangeMeDefault123!


# ─── Encryption ───────────────────────────────────────────────────────────────

ENCRYPTION_SECRET=CHANGE_ME_64_CHAR_HEX             # Generate: openssl rand -hex 64
ENCRYPTION_SALT=basaeer-production-salt-2026        # Change this to any random string


# ─── Redis ────────────────────────────────────────────────────────────────────
# Docker uses "redis" as hostname, bare VM uses "localhost"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                                     # Leave empty if no password set


# ─── CORS & URLs ──────────────────────────────────────────────────────────────

FRONTEND_URL=https://example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://api.example.com


# ─── SMTP (Email) ─────────────────────────────────────────────────────────────
# Brevo free tier: 300 emails/day — https://brevo.com
# Also supports SendGrid, Mailgun, Gmail, AWS SES, etc.

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME@brevo.com
SMTP_PASS=CHANGE_ME_SMTP_KEY
SMTP_FROM=noreply@example.com


# ─── SMS (Termii) ─────────────────────────────────────────────────────────────

TERMII_API_KEY=TL_CHANGE_ME
TERMII_SENDER_ID=Basaeer


# ─── Payments (Paystack - Nigeria) ────────────────────────────────────────────

PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME
PAYSTACK_PUBLIC_KEY=pk_test_CHANGE_ME


# ─── Google Meet Integration ──────────────────────────────────────────────────

GOOGLE_MEET_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_MEET_CLIENT_SECRET=GOCSPX-CHANGE_ME
GOOGLE_MEET_REDIRECT_URI=https://api.example.com/api/live-classes/auth/google/callback
GOOGLE_MEET_WEBHOOK_SECRET=CHANGE_ME_RANDOM_STRING
GOOGLE_MEET_SCOPES="https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/drive.readonly"


# ─── File Uploads (Cloudflare R2) ─────────────────────────────────────────────
# R2 is S3-compatible object storage. Get free 10GB at https://dash.cloudflare.com

R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=basaeer-uploads
R2_PUBLIC_DOMAIN=https://pub-CHANGE_ME.r2.dev
MAX_FILE_SIZE_MB=5


# ─── Docker Compose Helpers ───────────────────────────────────────────────────
# Only needed if using docker-compose.yml

POSTGRES_USER=basaeer
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=basaeer


# ─── Frontend ─────────────────────────────────────────────────────────────────
# Place in frontend/.env.local

NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_SHOW_BETA=false
